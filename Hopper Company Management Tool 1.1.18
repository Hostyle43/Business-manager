    # Inside class BusinessManagerApp (replace def load_project_management(self): with this)
    def load_project_management(self):
        # Clear the viewer pane to start fresh
        for widget in self.viewer_pane.winfo_children():
            widget.destroy()
    
        # Create a sub-frame as a "container" for buttons and other widgets
        proj_frame = tk.Frame(self.viewer_pane, bg="blue", padx=10, pady=10)
        proj_frame.pack(fill='both', expand=True)  # Fills the viewer pane
    
        # Add a title label for context
        tk.Label(proj_frame, text="Project Management", bg="darkblue", fg="yellow", font=("Arial", 20, "bold")).pack(pady=10)
    
        # "Create New Project" button (your existing one)
        tk.Button(
            proj_frame,
            text="Create New Project",
            command=self.create_new_project,
            bg="lightblue", fg="black", font=("Arial", 14)
        ).pack(fill='x', padx=5, pady=5)
    
        # "Load Existing Project" button (your existing one)
        tk.Button(
            proj_frame,
            text="Load Existing Project",
            command=self.load_existing_project,
            bg="lightblue", fg="black", font=("Arial", 14)
        ).pack(fill='x', padx=5, pady=5)
    
        # "Delete Project" button – uncommented and fixed
        tk.Button(
            proj_frame,
            text="Delete Project",
            command=self.delete_project,
            bg="lightgray", fg="red", font=("Arial", 14,)
        ).pack(fill='x', padx=5, pady=5)
    
        # Optional: Add more widgets (e.g., your project listbox)
        tk.Label(proj_frame, text="Project List:").pack(pady=5)
        project_listbox = tk.Listbox(proj_frame)
        project_listbox.pack(fill='both', expand=True)
        # Populate dynamically if desired (example below)
        if "projects" in self.data:
            for proj in self.data["projects"]:
                project_listbox.insert(tk.END, proj)
    
    
    # Add this new method (for the button's command)
    # Inside class BusinessManagerApp (replace def create_new_project(self): with this)
    def create_new_project(self):
        project_name = tk.simpledialog.askstring("New Project", "Enter project name:")
        if not project_name:
            messagebox.showwarning("Cancelled", "Project creation cancelled.")
            return
    
        # Ask if based on an existing estimate
        use_existing = messagebox.askyesno("Use Existing Estimate?", "Is this project based on an existing estimate?")
    
        # Create a new estimate instance
        new_estimate = ExcavatingEstimate(project_name)
    
        if use_existing:
            # Check for existing projects
            if "projects" not in self.data or not self.data["projects"]:
                messagebox.showwarning("No Existing Projects", "No existing projects found. Switching to manual input.")
                self._manual_input_dialog(new_estimate)
            else:
                # Dialog to select existing project
                select_window = tk.Toplevel(self.root)
                select_window.title("Select Existing Estimate")
                select_window.geometry("300x200")
            
                tk.Label(select_window, text="Select an existing project to autofill from:").pack(pady=10)
            
                # Listbox of existing projects
                project_list = list(self.data["projects"].keys())
                listbox = tk.Listbox(select_window)
                for proj in project_list:
                    listbox.insert(tk.END, proj)
                listbox.pack(fill='both', expand=True, padx=10, pady=5)
            
                def on_select():
                    selected = listbox.get(tk.ACTIVE)
                    if selected:
                        existing_data = self.data["projects"][selected].get("estimate", {})
                        # Autofill new estimate with existing data
                        for key, value in existing_data.items():
                            if hasattr(new_estimate, key):
                                setattr(new_estimate, key, value)
                        select_window.destroy()
                    else:
                        messagebox.showwarning("No Selection", "No project selected. Switching to manual input.")
                        select_window.destroy()
                        self._manual_input_dialog(new_estimate)
            
                tk.Button(select_window, text="Select and Autofill", command=on_select).pack(pady=10)
                select_window.wait_window()  # Wait for dialog to close before proceeding
        else:
            # Manual input
            self._manual_input_dialog(new_estimate)
    
        # Save the new project
        if "projects" not in self.data:
            self.data["projects"] = {}
        self.data["projects"][project_name] = {"estimate": new_estimate.__dict__}  # Serialize class to dict
        save_data(self.data)
        messagebox.showinfo("Success", f"Created new project: {project_name}")
        # Optional: Refresh the project management view
        self.load_project_management()

    # Helper method for manual input dialog (add this right after create_new_project)
    def _manual_input_dialog(self, estimate):
        # Create a dialog for manual input
        input_window = tk.Toplevel(self.root)
        input_window.title("Manual Project Data Input")
        input_window.geometry("400x400")
    
        tk.Label(input_window, text="Enter project details below:").pack(pady=10)
    
        # Frame for scrollable inputs (in case of many fields)
        canvas = tk.Canvas(input_window)
        scrollbar = tk.Scrollbar(input_window, orient="vertical", command=canvas.yview)
        input_frame = tk.Frame(canvas)
    
        input_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=input_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
    
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
    
        # Example input fields (expand with all your ExcavatingEstimate attributes)
        fields = [
            ("Footing Length (ft)", "footing_length", 0.0),
            ("Footing Width (ft)", "footing_width", 0.0),
            ("Footing Depth (ft)", "footing_depth", 0.0),
            ("Wall Height (ft)", "wall_height", 0.0),
            ("Wall Thickness (in)", "wall_thickness", 0.0),
            # Add more fields here, e.g., ("Perimeter Drain Length (ft)", "perimeter_drain_length", 0.0),
            # ("Equipment Type", "equipment_type", ""),
        ]
    
        entries = {}
        for label, attr, default in fields:
            tk.Label(input_frame, text=label).pack(anchor="w", padx=10)
            entry = tk.Entry(input_frame)
            entry.insert(0, str(default))  # Pre-fill with default
            entry.pack(fill='x', padx=10, pady=2)
            entries[attr] = entry
    
        def on_save():
            for attr, entry in entries.items():
                value = entry.get()
                try:
                    # Convert to float for numeric fields (adjust for strings if needed)
                    setattr(estimate, attr, float(value) if value else 0.0)
                except ValueError:
                    messagebox.showwarning("Invalid Input", f"Invalid value for {attr}. Using default.")
                    setattr(estimate, attr, 0.0)
            input_window.destroy()
    
        tk.Button(input_frame, text="Save Details", command=on_save).pack(pady=10)
        input_window.wait_window()  # Wait for dialog to close



    def load_existing_project(self):
        # Check if there are any projects to load
        if "projects" not in self.data or not self.data["projects"]:
            messagebox.showwarning("No Projects", "No existing projects found. Create one first!")
            return
    
        # Create a simple dialog to select a project
        select_window = tk.Toplevel(self.root)
        select_window.title("Load Project")
        select_window.geometry("300x200")
    
        tk.Label(select_window, text="Select a project to load:").pack(pady=10)
    
        # Listbox to show projects
        project_list = list(self.data["projects"].keys())
        listbox = tk.Listbox(select_window)
        for proj in project_list:
            listbox.insert(tk.END, proj)
        listbox.pack(fill='both', expand=True, padx=10, pady=5)
    
        def on_load():
            selected = listbox.get(tk.ACTIVE)
            if selected:
                # Load the project data (example: restore ExcavatingEstimate)
                project_data = self.data["projects"][selected]
                self.current_estimate = ExcavatingEstimate(selected)  # Re-create class instance
                # Restore fields from data (expand this as needed)
                if "estimate" in project_data:
                    est = project_data["estimate"]
                    self.current_estimate.footing_length = est.get("footing_length", 0.0)
                    # ... restore other fields ...
            
                messagebox.showinfo("Loaded", f"Loaded project: {selected}")
                select_window.destroy()
                # Optional: Switch to estimator view or update UI
                self.load_excavating_estimator()  # E.g., auto-switch to show loaded data
            else:
                messagebox.showwarning("No Selection", "Please select a project.")
    
        tk.Button(select_window, text="Load", command=on_load).pack(pady=10)

    def delete_project(self):
        # Check if there are any projects to delete
        if "projects" not in self.data or not self.data["projects"]:
            messagebox.showwarning("No Projects", "No existing projects found.")
            return
    
        # Create a simple dialog to select a project
        select_window = tk.Toplevel(self.root)
        select_window.title("Delete Project")
        select_window.geometry("300x200")
    
        tk.Label(select_window, text="Select a project to delete:").pack(pady=10)
    
        # Listbox to show projects
        project_list = list(self.data["projects"].keys())
        listbox = tk.Listbox(select_window)
        for proj in project_list:
            listbox.insert(tk.END, proj)
        listbox.pack(fill='both', expand=True, padx=10, pady=5)
    
        def on_delete():
            selected = listbox.get(tk.ACTIVE)
            if selected:
                # Confirm deletion
                confirm = messagebox.askyesno("Confirm Delete", f"Are you sure you want to delete '{selected}'?")
                if confirm:
                    del self.data["projects"][selected]
                    save_data(self.data)
                    messagebox.showinfo("Deleted", f"Project '{selected}' deleted successfully.")
                    select_window.destroy()
                    # Optional: Refresh the project list in the viewer
                    self.load_project_management()  # Reload the view to update
            else:
                messagebox.showwarning("No Selection", "Please select a project.")
    
        tk.Button(select_window, text="Delete", command=on_delete).pack(pady=10)


