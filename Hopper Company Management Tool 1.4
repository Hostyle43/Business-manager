            ("Project Schedule", "proj-sched", ""), #insert interactive calendar
            ("Estimated costs", "est-cost", ""),
            ("Materials", "proj_material", ""), #insert interactive list
            # will expand this more later
        ]
    
        entries = {}
        for label, attr, default in fields:
            tk.Label(input_frame, text=label).pack(anchor="w", padx=10)
            entry = tk.Entry(input_frame)
            entry.insert(0, str(default))  # Pre-fill with default
            entry.pack(fill='x', padx=10, pady=2)
            entries[attr] = entry
    
        def on_save():
            for attr, entry in entries.items():
                value = entry.get()
                try:
                    # Convert to float for numeric fields (adjust for strings if needed)
                    setattr(estimate, attr, float(value) if value else 0.0)
                except ValueError:
                    messagebox.showwarning("Invalid Input", f"Invalid value for {attr}. Using default.")
                    setattr(estimate, attr, 0.0)
            input_window.destroy()
    
        tk.Button(input_frame, text="Save Details", command=on_save).pack(pady=10)
        input_window.wait_window()  # Wait for dialog to close



    def load_existing_project(self):
        # Check if there are any projects to load
        if "projects" not in self.data or not self.data["projects"]:
            messagebox.showwarning("No Projects", "No existing projects found. Create one first!")
            return
    
        # Create a simple dialog to select a project
        select_window = tk.Toplevel(self.root)
        select_window.title("Load Project")
        select_window.geometry("300x200")
    
        tk.Label(select_window, text="Select a project to load:").pack(pady=10)
    
        # Listbox to show projects
        project_list = list(self.data["projects"].keys())
        listbox = tk.Listbox(select_window)
        for proj in project_list:
            listbox.insert(tk.END, proj)
        listbox.pack(fill='both', expand=True, padx=10, pady=5)
    
        def on_load():
            selected = listbox.get(tk.ACTIVE)
            if selected:
                # Load the project data (example: restore ExcavatingEstimate)
                project_data = self.data["projects"][selected]
                self.current_estimate = ExcavatingEstimate(selected)  # Re-create class instance
                # Restore fields from data (expand this as needed)
                if "estimate" in project_data:
                    est = project_data["estimate"]
                    self.current_estimate.footing_length = est.get("footing_length", 0.0)
                    # ... restore other fields ...
            
                messagebox.showinfo("Loaded", f"Loaded project: {selected}")
                select_window.destroy()
                # Optional: Switch to estimator view or update UI
                self.load_excavating_estimator()  # E.g., auto-switch to show loaded data
            else:
                messagebox.showwarning("No Selection", "Please select a project.")
    
        tk.Button(select_window, text="Load", command=on_load).pack(pady=10)

    def delete_project(self):
        # Check if there are any projects to delete
        if "projects" not in self.data or not self.data["projects"]:
            messagebox.showwarning("No Projects", "No existing projects found.")
            return
    
        # Create a simple dialog to select a project
        select_window = tk.Toplevel(self.root)
        select_window.title("Delete Project")
        select_window.geometry("300x200")
    
        tk.Label(select_window, text="Select a project to delete:").pack(pady=10)
    
        # Listbox to show projects
        project_list = list(self.data["projects"].keys())
        listbox = tk.Listbox(select_window)
        for proj in project_list:
            listbox.insert(tk.END, proj)
        listbox.pack(fill='both', expand=True, padx=10, pady=5)
    
        def on_delete():
            selected = listbox.get(tk.ACTIVE)
            if selected:
                # Confirm deletion
                confirm = messagebox.askyesno("Confirm Delete", f"Are you sure you want to delete '{selected}'?")
                if confirm:
                    del self.data["projects"][selected]
                    save_data(self.data)
                    messagebox.showinfo("Deleted", f"Project '{selected}' deleted successfully.")
                    select_window.destroy()
                    # Optional: Refresh the project list in the viewer
                    self.load_project_management()  # Reload the view to update
            else:
                messagebox.showwarning("No Selection", "Please select a project.")
    
        tk.Button(select_window, text="Delete", command=on_delete).pack(pady=10)
        
