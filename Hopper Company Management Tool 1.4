# --- Excavating Estimator Classes ---

class Estimate:
    def __init__(self, project_name):
        self.project_name = project_name
        self.date = datetime.now().strftime("%Y-%m-%d")

class ExcavatingEstimate:
    def __init__(self, project_name):
        self.project_name = project_name  # Required: Project identifier
        
        # Initialize all attributes with defaults (matching your input fields)
        self.found_ex_vol = 0  # Foundation excavation (cu yd)
        self.sub_grade_vol = 0  # Subgrades (cu yd)
        self.int_slab_area = 0  # Interior slabs (sq ft)
        self.ext_slab_area = 0  # Exterior slabs (sq ft)
        self.pdrain_length = 0  # Perimeter drain (ft)
        self.water_line_length = 0  # Water line (ft)
        self.sewer_line_length = 0  # Sewer line (ft)
        self.elec_line_length = 0  # Electric line (ft)
        self.gas_line_length = 0  # Gas line (ft)
        self.tank_ex_vol = 0  # Tank excavations (cu yd)
        self.drive_area = 0  # Driveways/Parking (sq ft)
        self.topsoil_area = 0  # Topsoil and Seeding (sq ft)
        self.materials_import = 0  # Import materials (cu yd)
        self.materials_export = 0  # Export materials (cu yd)
        self.time_dump_truck = 0  # Dump truck time (hrs)
        self.time_equipment = 0  # Equipment time (hrs)
        self.time_labor = 0  # Labor time (hrs)
        self.time_operator = 0  # Operator time (hrs)
        self.time_super = 0  # Supervisor time (hrs)
        self.travel_distance = 0  # Travel distances (miles)
        self.proj_time = 0  # Total Project time (hrs)
        
        # Optional: Dynamic values from external RateCalculator (instead of hardcoding)
        # Instantiate and use it to fill some attributes dynamically
        self.rate_calculator = RateCalculator(base_rate=120.0, fuel_factor=1.3)  # Create instance
        self.equip_rate = self.rate_calculator.get_equip_rate(machine_type='excavator')  # Dynamic equip rate
        self.truck_rate = self.rate_calculator.get_equip_rate(machine_type='truck')  # Another dynamic value
        
        # Example: Compute a derived value using dynamic rates (e.g., a simple project cost)
        self.project_cost = self.calculate_project_cost()  # Call a method to use them

    def calculate_project_cost(self):
        # Example method: Use dynamic rates and other attributes for calculations
        # This could be expanded with more complex formulas
        equip_cost = self.equip_rate * self.time_equipment
        truck_cost = self.truck_rate * self.time_dump_truck
        total = equip_cost + truck_cost + (self.time_labor * 50.0)  # Example formula: $$ total = e_r \times t_e + t_r \times t_d + l \times 50 $$
        return total

    # Optional: Add other methods, e.g., for displaying or updating the estimate
    def __str__(self):
        return f"Estimate for {self.project_name}: Project Cost = {self.project_cost}"
   

