        # Clear viewer pane
        for widget in self.viewer_pane.winfo_children():
            widget.destroy()
        
        # Example content (expand with your editable codes/descriptions)
        lib_frame = tk.Frame(self.viewer_pane)
        lib_frame.pack(fill='both', expand=True)
        tk.Label(lib_frame, text="Work Library").pack(pady=10)
        # Add your full logic here, e.g., display and edit library from self.data

    
